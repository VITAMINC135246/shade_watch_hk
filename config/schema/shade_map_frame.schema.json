{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shade_map_frame.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "shade-map-frame-1.0"
    },
    "local_time": {
      "type": "string"
    },
    "utc_time": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{8}$"
    },
    "time": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "solar_by_tile": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pixel_count": {
      "type": "integer",
      "minimum": 0
    },
    "value_counts": {
      "type": "object",
      "properties": {
        "shade": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "surface": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "shade",
        "quality",
        "surface"
      ],
      "additionalProperties": false
    },
    "combinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "integer",
            "minimum": 0
          },
          "shade": {
            "type": "integer",
            "minimum": 0
          },
          "quality": {
            "type": "integer",
            "minimum": 0
          },
          "pixels": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "surface",
          "shade",
          "quality",
          "pixels"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "integrity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "local_time",
    "utc_time",
    "date",
    "time",
    "solar_by_tile",
    "pixel_count",
    "value_counts",
    "combinations",
    "files",
    "integrity_sha256"
  ],
  "additionalProperties": false
}
