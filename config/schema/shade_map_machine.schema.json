{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shade_map_machine.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "shade-map-machine-1.0"
    },
    "dsm_dir": {
      "type": "string",
      "minLength": 1
    },
    "sea_profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "default": "hk_cedd_2020"
    },
    "output_root": {
      "type": "string",
      "minLength": 1,
      "default": "runs"
    },
    "cache_namespace": {
      "type": "string",
      "minLength": 1,
      "default": "raw"
    },
    "workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "default": 1
    },
    "memory_budget_mb": {
      "type": "integer",
      "minimum": 512,
      "maximum": 12288,
      "default": 8192
    },
    "max_output_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "default": null
    },
    "cities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "raw_dir"
        ],
        "additionalProperties": false,
        "properties": {
          "raw_dir": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "dsm_dir"
  ],
  "additionalProperties": false
}
