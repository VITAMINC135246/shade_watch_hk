{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shade_map_plan.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "shade-map-plan-1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "name": {
      "type": "string"
    },
    "resolved_bounds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "grid": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "transform": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "crs": {
          "type": "string",
          "pattern": "^EPSG:[1-9][0-9]*$"
        },
        "mode": {
          "type": "string"
        },
        "selected_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "width",
        "height",
        "transform",
        "crs",
        "mode",
        "selected_source",
        "selected_sources"
      ],
      "additionalProperties": false
    },
    "pixel_count": {
      "type": "integer",
      "minimum": 0
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e-?\\d+(?:\\.5)?n-?\\d+(?:\\.5)?$"
          },
          "native_bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "width": {
            "type": "integer",
            "minimum": 0
          },
          "height": {
            "type": "integer",
            "minimum": 0
          },
          "source_tile": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "native_bounds",
          "bounds",
          "width",
          "height",
          "source_tile"
        ],
        "additionalProperties": false
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "local_time": {
            "type": "string"
          },
          "utc_time": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "time": {
            "type": "string",
            "pattern": "^\\d{4}$"
          }
        },
        "required": [
          "local_time",
          "utc_time",
          "date",
          "time"
        ],
        "additionalProperties": false
      }
    },
    "dropped_times": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "local_time": {
            "type": "string"
          },
          "utc_time": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "const": "outside daylight"
          }
        },
        "required": [
          "local_time",
          "utc_time",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "sub_requests": {
      "type": "integer",
      "minimum": 0
    },
    "batches": {
      "type": "integer",
      "minimum": 0
    },
    "distinct_horizon_directions": {
      "type": "integer",
      "minimum": 0
    },
    "estimates": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "const": "estimate"
        },
        "compute_wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "estimator_models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extrapolated": {
                "type": "boolean"
              }
            },
            "required": [
              "schema",
              "sha256",
              "extrapolated"
            ],
            "additionalProperties": false
          }
        },
        "published_bytes": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "const": "estimate"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "label",
            "value"
          ],
          "additionalProperties": false
        },
        "working_bytes": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "const": "estimate"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "label",
            "value"
          ],
          "additionalProperties": false
        },
        "file_count": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "const": "estimate"
            },
            "value": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "label",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "label",
        "compute_wall_seconds",
        "estimator_models",
        "published_bytes",
        "working_bytes",
        "file_count"
      ],
      "additionalProperties": false
    },
    "full_images": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_run": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "new",
            "resumable",
            "complete",
            "conflict"
          ]
        },
        "published_frames": {
          "type": "integer",
          "minimum": 0
        },
        "total_frames": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "published_frames",
        "total_frames"
      ],
      "additionalProperties": false
    },
    "city": {
      "type": "object",
      "properties": {
        "city_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "crs": {
          "type": "string",
          "pattern": "^EPSG:[1-9][0-9]*$"
        },
        "timezone": {
          "type": "string"
        },
        "daylight_reference": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "vertical_datum": {
          "type": "string"
        },
        "ingest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "city_id",
        "profile_sha256",
        "crs",
        "timezone",
        "daylight_reference",
        "vertical_datum"
      ],
      "additionalProperties": false
    },
    "missing_direction_jobs": {
      "type": "integer",
      "minimum": 0
    },
    "fill_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "no_dsm_cells_within_1km": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "no_dsm_cells_within_1km"
      ]
    },
    "projection": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "accuracy_m": {
          "type": "number",
          "minimum": -1
        },
        "pyproj_version": {
          "type": "string"
        },
        "proj_version": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "accuracy_m",
        "pyproj_version",
        "proj_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "run_id",
    "name",
    "resolved_bounds",
    "grid",
    "pixel_count",
    "cells",
    "frames",
    "dropped_times",
    "sub_requests",
    "batches",
    "distinct_horizon_directions",
    "estimates",
    "full_images",
    "warnings",
    "existing_run",
    "city",
    "missing_direction_jobs",
    "fill_context"
  ],
  "additionalProperties": false
}
