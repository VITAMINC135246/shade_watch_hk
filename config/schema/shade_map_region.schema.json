{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shade_map_region.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "shade-map-region-1.0",
        "shade-map-region-1.1"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$"
    },
    "crs": {
      "type": "string",
      "enum": [
        "wgs84",
        "hk1980",
        "projected"
      ],
      "default": "wgs84"
    },
    "lower_left": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "upper_right": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "time": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "daylight"
            },
            "dates": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 366,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "interval_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 10
            }
          },
          "required": [
            "mode",
            "dates"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "window"
            },
            "dates": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 366,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "interval_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 10
            },
            "start": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            },
            "end": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": [
            "mode",
            "dates",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "instants"
            },
            "instants": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?)?$"
              }
            }
          },
          "required": [
            "mode",
            "instants"
          ],
          "additionalProperties": false
        }
      ]
    },
    "dsm_source": {
      "type": "string",
      "enum": [
        "raw",
        "sea-2.2"
      ],
      "description": "Defaults to raw in 1.0 and sea-2.2 in 1.1."
    },
    "full_image": {
      "type": "string",
      "enum": [
        "auto",
        "never"
      ],
      "default": "auto"
    },
    "city": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    }
  },
  "required": [
    "schema",
    "name",
    "lower_left",
    "upper_right",
    "time"
  ],
  "additionalProperties": false
}
