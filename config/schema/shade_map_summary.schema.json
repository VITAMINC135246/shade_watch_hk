{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shade_map_summary.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "shade-map-summary-1.0"
    },
    "denominator": {
      "type": "string",
      "const": "whole surface class"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "local_time": {
            "type": "string"
          },
          "utc_time": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "time": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surface": {
                  "type": "integer",
                  "minimum": 0
                },
                "pixels": {
                  "type": "integer",
                  "minimum": 0
                },
                "counts": {
                  "type": "object",
                  "properties": {
                    "sunlit": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "shaded": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "uncertain": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "sunlit",
                    "shaded",
                    "uncertain"
                  ],
                  "additionalProperties": false
                },
                "quality_counts": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "fractions": {
                  "type": "object",
                  "properties": {
                    "sunlit": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "shaded": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "uncertain": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "sunlit",
                    "shaded",
                    "uncertain"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "surface",
                "pixels",
                "counts",
                "quality_counts",
                "fractions"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "local_time",
          "utc_time",
          "date",
          "time",
          "surfaces"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "denominator",
    "frames"
  ],
  "additionalProperties": false
}
